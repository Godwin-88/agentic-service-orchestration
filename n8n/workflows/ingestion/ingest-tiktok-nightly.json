{
  "name": "ingest-tiktok-nightly",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "interval": 1,
              "triggerAtHour": 2,
              "triggerAtMinute": 20
            }
          ]
        }
      },
      "name": "Trigger - Daily 2:20 AM UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS channel_id, account_id, access_token_encrypted FROM channels WHERE platform = 'tiktok' AND connected_status = 'connected' LIMIT 5;"
      },
      "name": "Query - Connected TikTok",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "postgres": {"id": "jtNPm35xuYntlcNR", "name": "PostgreSQL - Marketing Hub"}
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://open.tiktokapis.com/v1/video/list?access_token={{ $json.access_token_encrypted }}&fields=video_id,share_count,view_count,like_count,comment_count,download_count,create_time",
        "authentication": "none",
        "options": {}
      },
      "name": "API - TikTok Videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst transformed = [];\n\nitems.forEach((item) => {\n  const data = item.json.data?.videos || [];\n  const channelId = item.json.channel_id;\n  \n  data.forEach(video => {\n    const views = video.view_count || 0;\n    const likes = video.like_count || 0;\n    const comments = video.comment_count || 0;\n    const shares = video.share_count || 0;\n    const downloads = video.download_count || 0;\n    const engagement = likes + comments + shares + downloads;\n    \n    transformed.push({\n      json: {\n        channel_id: channelId,\n        platform: 'tiktok',\n        metric_date: new Date().toISOString().split('T')[0],\n        reach: parseInt(views),\n        impressions: parseInt(views),\n        engagements: parseInt(engagement),\n        clicks: 0,\n        likes: parseInt(likes),\n        comments: parseInt(comments),\n        shares: parseInt(shares),\n        saves: parseInt(downloads),\n        video_views: parseInt(views),\n        watch_time_seconds: 0,\n        profile_visits: 0,\n        follower_count: 0,\n        created_at: new Date().toISOString()\n      }\n    });\n  });\n});\n\nreturn transformed;"
      },
      "name": "Transform - TikTok Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "post_metrics",
        "columns": "channel_id,metric_date,reach,impressions,engagements,clicks,likes,comments,shares,saves,video_views,watch_time_seconds,profile_visits,follower_count,created_at",
        "fieldsUi": {
          "values": [
            { "fieldName": "channel_id", "fieldValue": "={{ $json.channel_id }}" },
            { "fieldName": "metric_date", "fieldValue": "={{ $json.metric_date }}" },
            { "fieldName": "reach", "fieldValue": "={{ $json.reach }}" },
            { "fieldName": "impressions", "fieldValue": "={{ $json.impressions }}" },
            { "fieldName": "engagements", "fieldValue": "={{ $json.engagements }}" },
            { "fieldName": "clicks", "fieldValue": "={{ $json.clicks }}" },
            { "fieldName": "likes", "fieldValue": "={{ $json.likes }}" },
            { "fieldName": "comments", "fieldValue": "={{ $json.comments }}" },
            { "fieldName": "shares", "fieldValue": "={{ $json.shares }}" },
            { "fieldName": "saves", "fieldValue": "={{ $json.saves }}" },
            { "fieldName": "video_views", "fieldValue": "={{ $json.video_views }}" },
            { "fieldName": "watch_time_seconds", "fieldValue": "={{ $json.watch_time_seconds }}" },
            { "fieldName": "profile_visits", "fieldValue": "={{ $json.profile_visits }}" },
            { "fieldName": "follower_count", "fieldValue": "={{ $json.follower_count }}" },
            { "fieldName": "created_at", "fieldValue": "={{ $json.created_at }}" }
          ]
        }
      },
      "name": "DB - Insert Metrics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1050, 300],
      "credentials": {
        "postgres": {"id": "jtNPm35xuYntlcNR", "name": "PostgreSQL - Marketing Hub"}
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "action_log",
        "columns": "action_type,resource_type,actor,actor_type,status,details,created_at",
        "fieldsUi": {
          "values": [
            { "fieldName": "action_type", "fieldValue": "workflow_execution" },
            { "fieldName": "resource_type", "fieldValue": "ingestion" },
            { "fieldName": "actor", "fieldValue": "n8n" },
            { "fieldName": "actor_type", "fieldValue": "system" },
            { "fieldName": "status", "fieldValue": "success" },
            { "fieldName": "details", "fieldValue": "={{ JSON.stringify({ workflow: 'ingest-tiktok-nightly', metrics_count: $input.all().length }) }}" },
            { "fieldName": "created_at", "fieldValue": "=now()" }
          ]
        }
      },
      "name": "DB - Log Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": {
        "postgres": {"id": "jtNPm35xuYntlcNR", "name": "PostgreSQL - Marketing Hub"}
      }
    }
  ],
  "connections": {
    "Trigger - Daily 2:20 AM UTC": { "main": [[{ "node": "Query - Connected TikTok", "type": "main", "index": 0 }]] },
    "Query - Connected TikTok": { "main": [[{ "node": "API - TikTok Videos", "type": "main", "index": 0 }]] },
    "API - TikTok Videos": { "main": [[{ "node": "Transform - TikTok Metrics", "type": "main", "index": 0 }]] },
    "Transform - TikTok Metrics": { "main": [[{ "node": "DB - Insert Metrics", "type": "main", "index": 0 }]] },
    "DB - Insert Metrics": { "main": [[{ "node": "DB - Log Success", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {}
}