{
  "name": "ingest-linkedin-nightly",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "interval": 1,
              "triggerAtHour": 2,
              "triggerAtMinute": 10
            }
          ]
        }
      },
      "name": "Trigger - Daily 2:10 AM UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS channel_id, account_id, access_token_encrypted FROM channels WHERE platform = 'linkedin' AND connected_status = 'connected' LIMIT 5;"
      },
      "name": "Query - Connected LinkedIn",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [450, 300],
      "credentials": {
        "postgres": {
          "id": "jtNPm35xuYntlcNR",
          "name": "PostgreSQL - Marketing Hub"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.linkedin.com/v2/posts?author={{ $json.account_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.access_token_encrypted }}" }
          ]
        },
        "authentication": "none",
        "options": {}
      },
      "name": "API - LinkedIn Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst transformed = [];\n\nitems.forEach((item) => {\n  const elements = item.json.elements || [];\n  const channelId = item.json.channel_id;\n  \n  elements.forEach(post => {\n    const impressions = post.totalShareStatistics?.impressionCount || 0;\n    const clicks = post.totalShareStatistics?.clickCount || 0;\n    const engagement = (post.totalShareStatistics?.likeCount || 0) + (post.totalShareStatistics?.commentCount || 0) + (post.totalShareStatistics?.shareCount || 0);\n    \n    transformed.push({\n      json: {\n        channel_id: channelId,\n        platform: 'linkedin',\n        metric_date: new Date().toISOString().split('T')[0],\n        reach: 0,\n        impressions: parseInt(impressions),\n        engagements: parseInt(engagement),\n        clicks: parseInt(clicks),\n        likes: parseInt(post.totalShareStatistics?.likeCount || 0),\n        comments: parseInt(post.totalShareStatistics?.commentCount || 0),\n        shares: parseInt(post.totalShareStatistics?.shareCount || 0),\n        saves: 0,\n        video_views: 0,\n        watch_time_seconds: 0,\n        profile_visits: 0,\n        follower_count: 0,\n        created_at: new Date().toISOString()\n      }\n    });\n  });\n});\n\nreturn transformed;"
      },
      "name": "Transform - LinkedIn Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "post_metrics",
        "columns": "channel_id,metric_date,reach,impressions,engagements,clicks,likes,comments,shares,saves,video_views,watch_time_seconds,profile_visits,follower_count,created_at",
        "fieldsUi": {
          "values": [
            { "fieldName": "channel_id", "fieldValue": "={{ $json.channel_id }}" },
            { "fieldName": "metric_date", "fieldValue": "={{ $json.metric_date }}" },
            { "fieldName": "reach", "fieldValue": "={{ $json.reach }}" },
            { "fieldName": "impressions", "fieldValue": "={{ $json.impressions }}" },
            { "fieldName": "engagements", "fieldValue": "={{ $json.engagements }}" },
            { "fieldName": "clicks", "fieldValue": "={{ $json.clicks }}" },
            { "fieldName": "likes", "fieldValue": "={{ $json.likes }}" },
            { "fieldName": "comments", "fieldValue": "={{ $json.comments }}" },
            { "fieldName": "shares", "fieldValue": "={{ $json.shares }}" },
            { "fieldName": "saves", "fieldValue": "={{ $json.saves }}" },
            { "fieldName": "video_views", "fieldValue": "={{ $json.video_views }}" },
            { "fieldName": "watch_time_seconds", "fieldValue": "={{ $json.watch_time_seconds }}" },
            { "fieldName": "profile_visits", "fieldValue": "={{ $json.profile_visits }}" },
            { "fieldName": "follower_count", "fieldValue": "={{ $json.follower_count }}" },
            { "fieldName": "created_at", "fieldValue": "={{ $json.created_at }}" }
          ]
        }
      },
      "name": "DB - Insert Metrics",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1050, 300],
      "credentials": {
        "postgres": {
          "id": "jtNPm35xuYntlcNR",
          "name": "PostgreSQL - Marketing Hub"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "action_log",
        "columns": "action_type,resource_type,actor,actor_type,status,details,created_at",
        "fieldsUi": {
          "values": [
            { "fieldName": "action_type", "fieldValue": "workflow_execution" },
            { "fieldName": "resource_type", "fieldValue": "ingestion" },
            { "fieldName": "actor", "fieldValue": "n8n" },
            { "fieldName": "actor_type", "fieldValue": "system" },
            { "fieldName": "status", "fieldValue": "success" },
            { "fieldName": "details", "fieldValue": "={{ JSON.stringify({ workflow: 'ingest-linkedin-nightly', metrics_count: $input.all().length }) }}" },
            { "fieldName": "created_at", "fieldValue": "=now()" }
          ]
        }
      },
      "name": "DB - Log Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": {
        "postgres": {
          "id": "jtNPm35xuYntlcNR",
          "name": "PostgreSQL - Marketing Hub"
        }
      }
    }
  ],
  "connections": {
