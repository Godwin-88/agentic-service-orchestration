    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO lead_interactions (lead_id, interaction_type, message_text, interaction_metadata, created_at) VALUES ((SELECT id FROM leads WHERE LOWER(email) = LOWER('{{ $node['Transform - Normalize Lead'].json.email }}')), 'dm', '{{ $node['Transform - Normalize Lead'].json.message_text }}', '{{ $node['Transform - Normalize Lead'].json.interaction_metadata }}', NOW()); UPDATE leads SET lead_score = lead_score + 5, lead_stage = 'engaged' WHERE LOWER(email) = LOWER('{{ $node['Transform - Normalize Lead'].json.email }}') AND lead_stage = 'new';"
      },
