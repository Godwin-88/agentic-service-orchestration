# === Database Configuration ===
DB_NAME=marketing_hub
DB_USER=postgres
DB_PASSWORD=postgres_dev
DB_PORT=5432

# === Infrastructure ===
NODE_ENV=production
APP_DOMAIN=localhost
LOG_LEVEL=info

# === n8n Configuration ===
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change_me_in_production_minimum_32_characters_required

# === Redis Configuration ===
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# === Agents Service Configuration ===
AGENTS_PORT=8000
AGENT_API_KEY=change_me_in_production

# === Metabase Configuration ===
METABASE_PORT=3001
METABASE_SECRET=change_me_in_production

# === LLM API Keys ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Groq (OpenAI-compatible)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=openai # openai, anthropic, or groq

# === Meta (Facebook, Instagram) ===
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_facebook_page_id
META_ACCESS_TOKEN=your_meta_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# === LinkedIn ===
LINKEDIN_APP_ID=your_linkedin_app_id
LINKEDIN_APP_SECRET=your_linkedin_app_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_ORG_ID=your_organization_id
LINKEDIN_DEVELOPER_TOKEN=your_developer_token

# === TikTok ===
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ADVERTISER_ID=your_tiktok_advertiser_id

# === YouTube ===
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# === WhatsApp ===
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Optional: if using 360Dialog BSP instead of Meta Cloud API
# WHATSAPP_360_API_KEY=your_360dialog_api_key

# === CRM Integration ===
# HubSpot
HUBSPOT_API_KEY=pat-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OR Pipedrive
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token
# OR Salesforce
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_INSTANCE_URL=https://your_instance.salesforce.com

# === Search & Intelligence ===
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# === Notifications ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@marketing.example.com

# === GDPR & Compliance ===
DATA_REGION=EU  # EU, US, APAC
ENABLE_GDPR_LOGS=true
UNSUBSCRIBE_LINK_TEMPLATE=https://marketing.example.com/unsubscribe?email={{email}}&token={{token}}
